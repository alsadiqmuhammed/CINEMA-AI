# --- Required in production ---
NODE_ENV=production
APP_BASE_URL=https://shop.example.com
# 32+ random characters: openssl rand -hex 32
APP_SECRET=
DATABASE_URL=postgres://user:password@host:5432/store
# DATABASE_SSL=require   # or no-verify if the provider uses a self-signed certificate

# First owner account (created by `npm run seed`)
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Local numbers starting with 0 are stored in international form. Examples: 966, 965, 971, 964
DEFAULT_COUNTRY_CODE=966

# --- AI (Claude). Empty = built-in templates and keyword replies ---
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5
AI_CHAT_REQUESTS_PER_HOUR=60

# --- WhatsApp Business Cloud API (Meta). Empty = WhatsApp off ---
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_API_VERSION=v21.0
# Approved message templates, used outside the 24-hour customer-service window
WHATSAPP_TEMPLATE_ABANDONED_CART=
WHATSAPP_TEMPLATE_REVIEW_REQUEST=

# --- Automation ---
AUTOMATION_ENABLED=true
AUTOMATION_INTERVAL_MINUTES=5
ABANDONED_CART_HOURS=3
ORDER_DELAY_HOURS=48
REVIEW_REQUEST_DAYS=3
VIP_LIFETIME_VALUE=500
