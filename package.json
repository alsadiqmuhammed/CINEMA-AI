{
  "name": "cinema-ai-store",
  "version": "0.1.0",
  "private": true,
  "description": "متجر إلكتروني مؤتمت بالذكاء الاصطناعي مع رقابة بشرية على القرارات الحساسة",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "migrate": "node src/db/migrate.js",
    "seed": "node src/db/seed.js",
    "worker": "node src/automation/worker.js",
    "test": "node --test --test-concurrency=1 test/*.test.js",
    "check": "for f in $(find src -name '*.js') public/js/*.js; do node --check $f || exit 1; done"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.0.0",
    "cookie-parser": "^1.4.7",
    "express": "^5.3.0",
    "multer": "^2.4.0",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  }
}
