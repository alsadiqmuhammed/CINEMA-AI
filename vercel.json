{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "node src/db/migrate.js",
  "outputDirectory": "public",
  "functions": {
    "api/index.js": { "includeFiles": "{src,public}/**", "maxDuration": 60 }
  },
  "rewrites": [{ "source": "/(.*)", "destination": "/api" }],
  "crons": [{ "path": "/cron/automation", "schedule": "0 7 * * *" }]
}
